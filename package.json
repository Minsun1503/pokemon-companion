{
  "name": "pokemon-computer-companion",
  "version": "0.2.1",
  "private": true,
  "description": "An animated Pokémon desktop companion for AI computer use through MCP",
  "scripts": {
    "setup": "node scripts/repos.cjs install",
    "setup:ci": "node scripts/repos.cjs ci",
    "build": "node scripts/repos.cjs run build",
    "check": "node scripts/repos.cjs check",
    "test": "node scripts/repos.cjs test && node --test scripts/chat.test.cjs scripts/pikachu-animation.test.cjs scripts/youtube-benchmark.test.mjs scripts/common-task-benchmark.test.mjs scripts/desktop-workflows.test.mjs scripts/workflow-controller.test.mjs",
    "desktop:client": "node scripts/desktop-client.mjs",
    "test:desktop-client": "node --test scripts/desktop-workflows.test.mjs",
    "workflow:client": "node scripts/workflow-client.mjs",
    "test:workflow-client": "node --test scripts/workflow-controller.test.mjs",
    "benchmark:workflow-controller": "node scripts/workflow-controller-benchmark.mjs",
    "start": "node backend/dist/main.js",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "config": "node scripts/config.cjs",
    "test:input": "node scripts/input-smoke.mjs",
    "test:windows": "node scripts/windows-smoke.mjs && node scripts/windows-fast-path-smoke.mjs && node scripts/keyboard-guard-smoke.mjs && node scripts/companion-focus-smoke.mjs",
    "test:windows:contract": "node scripts/windows-contract-smoke.mjs",
    "test:windows:identity": "node scripts/windows-identity-smoke.mjs",
    "test:windows:coordination": "node scripts/windows-coordination-smoke.mjs",
    "test:work-animation": "node scripts/work-animation-smoke.mjs",
    "test:companion-drag": "node scripts/companion-drag-smoke.mjs",
    "test:course": "node scripts/course-smoke.mjs",
    "test:excel": "node scripts/excel-smoke.mjs",
    "benchmark:windows": "node scripts/windows-benchmark.mjs",
    "benchmark:youtube": "node scripts/youtube-benchmark.mjs",
    "benchmark:retrieval": "node scripts/information-retrieval-benchmark.mjs",
    "benchmark:common": "node scripts/common-task-benchmark.mjs",
    "test:common-benchmark": "node --test scripts/common-task-benchmark.test.mjs",
    "test:youtube-benchmark": "node --test scripts/youtube-benchmark.test.mjs",
    "benchmark:windows:phases": "node scripts/windows-phase-benchmark.mjs",
    "test:windows:child-cache": "node scripts/windows-child-cache-smoke.mjs",
    "test:learning": "node scripts/learning-smoke.mjs && node scripts/learning-ui-smoke.mjs && node scripts/http-auth-smoke.mjs && node scripts/learning-contract-smoke.mjs",
    "benchmark:learning": "node scripts/learning-benchmark.mjs",
    "benchmark:ranker": "node scripts/local-ranker-benchmark.mjs",
    "package:windows": "npm run build && node scripts/package-windows.cjs",
    "package:test-app": "node scripts/package-standalone.cjs",
    "package:desktop": "node scripts/package-desktop.cjs",
    "test:desktop-package": "node scripts/desktop-package-smoke.cjs",
    "test:client-package": "node scripts/client-package-smoke.cjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:installers": "node scripts/installer-smoke.cjs",
    "test:marketplace": "node scripts/marketplace-smoke.mjs"
  }
}
